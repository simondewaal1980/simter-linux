#!/bin/sh
# Verwijder LightDM dat via desktop-recommendations in de live-omgeving
# belandt. LightDM zou de live-autologin van live-config (SDDM) omzeilen.
#
# NVIDIA-driverpakketten blijven bewust staan: de ISO ondersteunt zowel
# NVIDIA als Mesa. quickshell-gpu-setup kiest bij het opstarten welke
# GLX-implementatie bij de aanwezige hardware hoort, zodat een machine
# zonder NVIDIA geen kapotte GLX-alternative krijgt.
set -e

pkgs=$(dpkg-query -W -f='${Package}\n' 2>/dev/null \
    | grep -E '^lightdm' | sort -u || true)
if [ -n "$pkgs" ]; then
    DEBIAN_FRONTEND=noninteractive apt-get purge -y $pkgs || true
fi

# SDDM blijft de displaymanager na het opruimen.
if command -v sddm >/dev/null 2>&1; then
    printf '/usr/bin/sddm\n' >/etc/X11/default-display-manager
    ln -sf /lib/systemd/system/sddm.service /etc/systemd/system/display-manager.service
fi

exit 0
