/* colors.rasi — gegenereerd door matugen uit de wallpaper. Niet handmatig aanpassen.
 * Wordt geïmporteerd door ~/.config/rofi/config.rasi.
 */

* {
    bg: {{ colors.background.default.hex }};
    bg-alt: {{ colors.surface_container_high.default.hex }};
    bg-hover: {{ colors.surface_container_highest.default.hex }};
    fg: {{ colors.on_background.default.hex }};
    muted: {{ colors.on_surface_variant.default.hex }};
    accent: {{ colors.primary.default.hex }};
    on-accent: {{ colors.on_primary.default.hex }};
    red: {{ colors.error.default.hex }};
}
